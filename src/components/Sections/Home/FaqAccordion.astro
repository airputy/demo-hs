---
// src/components/Sections/Home/FaqAccordion.astro - FAQ de la page d'accueil avec accordions natives et accessibles.
import SectionHeader from "@components/Sections/Global/SectionHeader.astro";
import { getLocale } from "@i18n";
import { annotationsDe, styleDuBloc } from "@moteur/annotations";
import Pastilles from "@moteur/Pastilles.astro";

const locale = getLocale(Astro);
const ed = annotationsDe(Astro, "faq");
const isEn = locale === "en";

const faqs = isEn
  ? [
      {
        question: "How much does the house cost per night?",
        answer:
          "Rates start from IDR 750,000 per night for the whole house. Send your dates on WhatsApp and I will confirm the exact price.",
      },
      {
        question: "How many guests can stay?",
        answer:
          "The house sleeps up to 6 guests, with 2 bedrooms and 1 bathroom.",
      },
      {
        question: "Do we rent the whole house?",
        answer:
          "Yes. You rent the entire house, so you do not share it with other guests.",
      },
      {
        question: "How do I book, and is a deposit required?",
        answer:
          "Message me on WhatsApp with your dates and number of guests, and I will check availability and confirm.",
      },
      {
        question: "What are the check-in and check-out times?",
        answer:
          "Check-in is after 2:00 PM and check-out is before 12:00 PM.",
      },
      {
        question: "Where is Olan Homestay?",
        answer:
          "At Tulip Rangkas Residence, Bojongleles, Cibadak District, Lebak Regency, Banten. Use Google Maps or ask me on WhatsApp for directions.",
      },
    ]
  : [
      {
        question: "Berapa harga sewa rumah per malam?",
        answer:
          "Harga mulai dari Rp 750.000 per malam untuk satu rumah utuh. Kirim tanggal menginap lewat WhatsApp, lalu saya akan konfirmasi harga yang tepat.",
      },
      {
        question: "Berapa maksimal tamu yang bisa tinggal?",
        answer:
          "Rumah ini bisa menampung sampai 6 tamu, dengan 2 kamar tidur dan 1 kamar mandi.",
      },
      {
        question: "Apakah yang disewa adalah rumah utuh?",
        answer:
          "Ya. Kamu menyewa seluruh rumah, jadi tidak berbagi dengan tamu lain.",
      },
      {
        question: "Cara booking dan apakah ada uang muka?",
        answer:
          "Kirim pesan lewat WhatsApp dengan tanggal dan jumlah tamu, lalu saya akan cek ketersediaan dan konfirmasi.",
      },
      {
        question: "Jam check-in dan check-out berapa?",
        answer:
          "Check-in setelah pukul 14.00 dan check-out sebelum pukul 12.00 siang.",
      },
      {
        question: "Dimana lokasi Olan Homestay?",
        answer:
          "Lokasinya di Tulip Rangkas Residence, Bojongleles, Kecamatan Cibadak, Kabupaten Lebak, Banten. Kamu bisa pakai Google Maps atau tanya saya lewat WhatsApp untuk arah yang lebih jelas.",
      },
    ];
---

<section
  class="bg-surface border-border border-t"
  aria-labelledby="faq-title"
  data-slot="faq"
  {...ed.entree}
  style={styleDuBloc(Astro, "faq")}
>
  <Pastilles cle="faq" masquable />

  <div class="container-page py-16 md:py-24">
    <SectionHeader
      as="h2"
      edition={ed}
      headingId="faq-title"
      eyebrow={isEn ? "FAQ" : "Pertanyaan umum"}
      title={isEn ? "Questions About Renting Olan Homestay" : "Pertanyaan Seputar Sewa Rumah di Olan Homestay"}
      accentWord={isEn ? "questions" : "pertanyaan"}
      lede={
        isEn
          ? "Quick answers to what guests ask most before booking."
          : "Jawaban singkat untuk hal yang paling sering ditanyakan sebelum kamu memesan."
      }
    />

    <div class="mt-10 space-y-4">
      {
        faqs.map((item, index) => (
          <details class="bg-card border-border group rounded-card border" open={index === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left md:px-6 md:py-5">
              <span class="text-foreground text-base font-medium md:text-lg">{item.question}</span>
              <span class="text-muted-foreground text-2xl leading-none transition-transform duration-200 group-open:rotate-45" aria-hidden="true">
                +
              </span>
            </summary>
            <div class="text-muted-foreground border-border border-t px-5 py-4 text-[0.97rem] leading-relaxed md:px-6 md:py-5">
              {item.answer}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
