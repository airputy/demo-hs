---
// src/components/Sections/Home/GalleryStory.astro - galerie visuel editorial de l'accueil : vue exterieure, salon, salle TV, chambres et piscine.
import SectionHeader from "@components/Sections/Global/SectionHeader.astro";
import { getLocale } from "@i18n";
import { annotationsDe, styleDuBloc } from "@moteur/annotations";
import Pastilles from "@moteur/Pastilles.astro";
import ruangTamu from "@assets/olan-homestay-ruang-tamu.webp";
import ruangTv from "@assets/olan-homestay-ruang-tv.webp";
import kamarUtama from "@assets/olan-homestay-kamar-utama.webp";
import kamarAnak from "@assets/olan-homestay-kamar-anak.webp";
import kamarMandi from "@assets/olan-homestay-kamar-mandi.webp";
import kolamAnak from "@assets/olan-homestay-kolam-renang-anak.webp";
import dapur from "@assets/olan-homestay-dapur.webp";

const locale = getLocale(Astro);
const ed = annotationsDe(Astro, "gallery-story");
const isEn = locale === "en";

const spaces = isEn
  ? [
      {
        title: "Living room",
        note: "A place for the family to gather.",
        alt: "Living room at Olan Homestay, Rangkasbitung",
        image: ruangTamu,
        span: "md:col-span-5",
      },
      {
        title: "TV room",
        note: "A TV room for evenings at home.",
        alt: "TV room at Olan Homestay",
        image: ruangTv,
        span: "md:col-span-7",
      },
      {
        title: "Main bedroom",
        note: "The main bedroom, for the parents.",
        alt: "Main bedroom at Olan Homestay",
        image: kamarUtama,
        span: "md:col-span-6",
      },
      {
        title: "Kids' bedroom",
        note: "The kids' bedroom.",
        alt: "Kids' bedroom at Olan Homestay",
        image: kamarAnak,
        span: "md:col-span-6",
      },
      {
        title: "Bathroom",
        note: "The house bathroom.",
        alt: "Bathroom at Olan Homestay",
        image: kamarMandi,
        span: "md:col-span-4",
      },
      {
        title: "Indoor children's pool",
        note: "Children's pool, inside the house.",
        alt: "Indoor children's pool at Olan Homestay",
        image: kolamAnak,
        span: "md:col-span-4",
      },
      {
        title: "Kitchen",
        note: "A kitchen for cooking your own meals.",
        alt: "Kitchen at Olan Homestay",
        image: dapur,
        span: "md:col-span-4",
      },
    ]
  : [
      {
        title: "Ruang tamu",
        note: "Tempat berkumpul bersama keluarga.",
        alt: "Ruang tamu di Olan Homestay, Rangkasbitung",
        image: ruangTamu,
        span: "md:col-span-5",
      },
      {
        title: "Ruang TV",
        note: "Ruang TV untuk malam di rumah.",
        alt: "Ruang TV di Olan Homestay",
        image: ruangTv,
        span: "md:col-span-7",
      },
      {
        title: "Kamar utama",
        note: "Kamar utama untuk orang tua.",
        alt: "Kamar utama di Olan Homestay",
        image: kamarUtama,
        span: "md:col-span-6",
      },
      {
        title: "Kamar anak",
        note: "Kamar anak.",
        alt: "Kamar anak di Olan Homestay",
        image: kamarAnak,
        span: "md:col-span-6",
      },
      {
        title: "Kamar mandi",
        note: "Kamar mandi rumah.",
        alt: "Kamar mandi di Olan Homestay",
        image: kamarMandi,
        span: "md:col-span-4",
      },
      {
        title: "Kolam anak",
        note: "Kolam anak, berada di dalam rumah.",
        alt: "Kolam renang anak di dalam rumah Olan Homestay",
        image: kolamAnak,
        span: "md:col-span-4",
      },
      {
        title: "Dapur",
        note: "Dapur untuk memasak sendiri.",
        alt: "Dapur di Olan Homestay",
        image: dapur,
        span: "md:col-span-4",
      },
    ];
---

<section
  class="bg-surface border-border border-t"
  aria-labelledby="gallery-story-title"
  data-slot="gallery-story"
  {...ed.entree}
  style={styleDuBloc(Astro, "gallery-story")}
>
  <Pastilles cle="gallery-story" masquable />

  <div class="container-page py-16 md:py-24">
    <SectionHeader
      as="h2"
      edition={ed}
      headingId="gallery-story-title"
      eyebrow={isEn ? "Stay inside" : "Kenali tempatnya"}
      title={isEn ? "Photos of Olan Homestay" : "Foto Rumah Olan Homestay"}
      accentWord={isEn ? "Photos" : "Foto"}
      lede={
        isEn
          ? "From the front porch to the kitchen, here is the whole house you will have to yourselves during your stay."
          : "Dari teras depan sampai dapur, inilah isi rumah yang kamu sewa utuh selama menginap."
      }
    />

    <div class="mt-10 grid gap-4 md:grid-cols-12">
      {
        spaces.map((space) => (
          <article
            class={`${space.span} group relative min-h-[18rem] overflow-hidden rounded-card border border-border bg-card shadow-float`}
          >
            <img
              src={space.image.src}
              alt={space.alt}
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/78 via-slate-900/15 to-transparent" aria-hidden="true"></div>
            <div class="relative flex h-full min-h-[18rem] flex-col justify-end p-5 md:p-6">
              <p class="mb-2 text-[0.68rem] font-medium tracking-[0.18em] text-white/70 uppercase">
                {isEn ? "Olan Homestay" : "Olan Homestay"}
              </p>
              <h3 class="font-display text-2xl font-semibold tracking-tight text-white">{space.title}</h3>
              <p class="mt-2 max-w-md text-sm leading-relaxed text-white/80">{space.note}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
